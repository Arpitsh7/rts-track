generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ShipmentStatus {
  CREATED
  PICKED_UP
  IN_TRANSIT
  AT_WAREHOUSE
  OUT_FOR_DELIVERY
  DELIVERED
  DELIVERY_FAILED
  RETURNED
  CANCELLED
}

enum ExceptionType {
  DELIVERY_FAILED
  CUSTOMER_UNAVAILABLE
  WRONG_ADDRESS
  DAMAGED
  DELAYED
  LOST
  OTHER
}

enum ExceptionStatus {
  OPEN
  INVESTIGATING
  RESOLVED
}

model ItemDetail {
  id         String   @id @default(uuid())
  name       String
  itemNumber String   @unique
  qty        Int
  createdAt  DateTime @default(now())

  shipments ShipmentDetail[]
}

model CustomerDetail {
  id      String @id @default(uuid())
  name    String
  PNo     String
  pincode String
  Address String

  shipments ShipmentDetail[]
}

model Rider {
  id        String   @id @default(uuid())
  name      String
  PNo       String
  pincode   String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shipments       ShipmentDetail[]
  trackingUpdates TrackUpdatesCustomer[]
}

model ShipmentDetail {
  id               String         @id @default(uuid())
  warehouseName    String
  warehousePincode String
  shipQR           String         @unique
  status           ShipmentStatus @default(CREATED)

  customerId String
  itemId     String
  riderId    String?

  customer CustomerDetail @relation(fields: [customerId], references: [id])
  item     ItemDetail     @relation(fields: [itemId], references: [id])
  rider    Rider?         @relation(fields: [riderId], references: [id])

  assignDriver String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  trackingUpdates TrackUpdatesCustomer[]
  exceptions      ShipmentException[]
}

model TrackUpdatesCustomer {
  id          String         @id @default(uuid())
  driverName  String?
  riderId     String?
  shipmentId  String
  remarks     String?
  trackUpdate ShipmentStatus
  createdAt   DateTime       @default(now())

  shipment ShipmentDetail @relation(fields: [shipmentId], references: [id])
  rider    Rider?         @relation(fields: [riderId], references: [id])
}

model ShipmentException {
  id          String          @id @default(uuid())
  shipmentId  String
  type        ExceptionType
  description String
  status      ExceptionStatus @default(OPEN)
  resolution  String?
  resolvedAt  DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  shipment ShipmentDetail @relation(fields: [shipmentId], references: [id])
}
